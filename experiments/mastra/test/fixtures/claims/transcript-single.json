[{"start": 0.0, "end": 4.0, "text": " Welcome back to the programme, it is good to have you with us again.", "words": [{"word": " Welcome", "speaker": "SPEAKER_00"}, {"word": " back", "speaker": "SPEAKER_00"}, {"word": " to", "speaker": "SPEAKER_00"}, {"word": " the", "speaker": "SPEAKER_00"}, {"word": " programme,", "speaker": "SPEAKER_00"}, {"word": " it", "speaker": "SPEAKER_00"}, {"word": " is", "speaker": "SPEAKER_00"}, {"word": " good", "speaker": "SPEAKER_00"}, {"word": " to", "speaker": "SPEAKER_00"}, {"word": " have", "speaker": "SPEAKER_00"}, {"word": " you", "speaker": "SPEAKER_00"}, {"word": " with", "speaker": "SPEAKER_00"}, {"word": " us", "speaker": "SPEAKER_00"}, {"word": " again.", "speaker": "SPEAKER_00"}]}, {"start": 4.0, "end": 9.5, "text": " The council approved a budget of four million pounds for the new road scheme last March.", "words": [{"word": " The", "speaker": "SPEAKER_00"}, {"word": " council", "speaker": "SPEAKER_00"}, {"word": " approved", "speaker": "SPEAKER_00"}, {"word": " a", "speaker": "SPEAKER_00"}, {"word": " budget", "speaker": "SPEAKER_00"}, {"word": " of", "speaker": "SPEAKER_00"}, {"word": " four", "speaker": "SPEAKER_00"}, {"word": " million", "speaker": "SPEAKER_00"}, {"word": " pounds", "speaker": "SPEAKER_00"}, {"word": " for", "speaker": "SPEAKER_00"}, {"word": " the", "speaker": "SPEAKER_00"}, {"word": " new", "speaker": "SPEAKER_00"}, {"word": " road", "speaker": "SPEAKER_00"}, {"word": " scheme", "speaker": "SPEAKER_00"}, {"word": " last", "speaker": "SPEAKER_00"}, {"word": " March.", "speaker": "SPEAKER_00"}]}, {"start": 9.5, "end": 12.0, "text": " I think that is too much money for one road.", "words": [{"word": " I", "speaker": "SPEAKER_00"}, {"word": " think", "speaker": "SPEAKER_00"}, {"word": " that", "speaker": "SPEAKER_00"}, {"word": " is", "speaker": "SPEAKER_00"}, {"word": " too", "speaker": "SPEAKER_00"}, {"word": " much", "speaker": "SPEAKER_00"}, {"word": " money", "speaker": "SPEAKER_00"}, {"word": " f