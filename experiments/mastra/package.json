{
  "name": "steele-exp-mastra",
  "private": true,
  "type": "module",
  "description": "n8n versus Mastra experiment (#911): Mastra track",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build --studio",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build:cli": "node cli/build.mjs",
    "pack:cli": "npm run build:cli && cd cli && npm pack"
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.19.2",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.82.0",
    "@mastra/libsql": "1.29.0",
    "@mastra/loggers": "1.3.10",
    "@mastra/observability": "1.23.1",
    "fast-xml-parser": "5.12.0",
    "html-to-text": "10.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/node": "22.18.6",
    "mastra": "1.38.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@mastra/deployer": "1.82.0",
    "@mastra/server": "1.82.0",
    "@mastra/core": "1.82.0"
  }
}
