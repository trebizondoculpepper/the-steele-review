{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trebizondoculpepper/the-steele-review/experiments/shared/schemas/article-v1.schema.json",
  "title": "Summary-and-critique article v1 (#911)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "critique", "conclusion", "warnings"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subtitle": { "type": "string", "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2500 },
    "critique": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "category", "why_it_matters"],
        "properties": {
          "point": { "type": "string", "minLength": 1, "maxLength": 600 },
          "category": { "enum": ["asserted", "established", "not-checked"] },
          "why_it_matters": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "conclusion": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "warnings": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } }
  }
}
