{
  "id": "SteeleExpDlvrBrows",
  "name": "Delivery: browse deliveries",
  "nodes": [
    {
      "id": "hook",
      "name": "Browse request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "steele-exp/delivery/browse",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "steele-exp-delivery-browse"
    },
    {
      "id": "val",
      "name": "Validate request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "parameters": {
        "jsCode": "const b = $json.body ?? {};\nconst op = String(b.op ?? '');\nif (!['list', 'read'].includes(op)) throw new Error('invalid-request: op must be list or read');\nif (op === 'read' && typeof b.requestId !== 'string') throw new Error('invalid-request: read needs requestId');\nreturn [{ json: { op, requestId: b.requestId ?? null, limit: Number.isInteger(b.limit) ? b.limit : 20 } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "q",
      "name": "Read",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        400,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE $1 WHEN 'list' THEN steele_dl.list($3::integer) ELSE steele_dl.read($2) END AS result",
        "options": {
          "queryReplacement": "={{ [$json.op, $json.requestId, $json.limit] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SteeleExpPgFeed01",
          "name": "steele-exp feed postgres"
        }
      }
    },
    {
      "id": "shape",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        200
      ],
      "parameters": {
        "jsCode": "const r = $json.result;\nif (r === null || r === undefined) return [{ json: { httpStatus: 404, error: 'not-found' } }];\nreturn [{ json: Array.isArray(r) ? { httpStatus: 200, deliveries: r } : { httpStatus: 200, ...r } }];"
      }
    },
    {
      "id": "ok",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.httpStatus ?? 200 }}"
        }
      }
    },
    {
      "id": "rej",
      "name": "Rejected",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        420
      ],
      "parameters": {
        "jsCode": "return [{ json: { httpStatus: 400, error: String($json.error?.message ?? $json.error).replace(/ \\[line \\d+\\]$/, '') } }];"
      }
    }
  ],
  "connections": {
    "Browse request": {
      "main": [
        [
          {
            "node": "Validate request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate request": {
      "main": [
        [
          {
            "node": "Read",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read": {
      "main": [
        [
          {
            "node": "Shape",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rejected": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "description": "list (bounded) and read one delivery record: request ID, article, target, status, draft ID, receipt, readback, every try and error."
  },
  "pinData": {}
}
