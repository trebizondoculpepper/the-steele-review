{
  "name": "the-steele-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/prompts', 'dist/prompts', {recursive:true})\"",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test": "vp test run test",
    "backfill": "node --enable-source-maps dist/cli/backfill.js",
    "index-worker": "node --enable-source-maps dist/cli/index-worker.js",
    "claim-timeline": "node --enable-source-maps dist/cli/claim-timeline.js",
    "replay-index": "node --enable-source-maps dist/cli/replay-index.js",
    "catch-up-index": "node --enable-source-maps dist/cli/catch-up-index.js",
    "captured-index-worker": "node --enable-source-maps dist/cli/captured-index-worker.js",
    "collect-worker": "node --enable-source-maps dist/cli/collect-worker.js",
    "fan-out-worker": "node --enable-source-maps dist/cli/fan-out-worker.js",
    "provision": "node --enable-source-maps dist/cli/provision.js",
    "extract-claims": "node --enable-source-maps dist/cli/extract-claims.js",
    "resolve-claims": "node --enable-source-maps dist/cli/resolve-claims.js",
    "list-posts": "node --enable-source-maps dist/cli/list-posts.js",
    "inspect-post": "node --enable-source-maps dist/cli/inspect-post.js",
    "operation": "node --enable-source-maps dist/cli/operation.js",
    "status": "node --enable-source-maps dist/cli/status.js",
    "post-trace": "node --enable-source-maps dist/cli/post-trace.js",
    "announce-post": "node --enable-source-maps dist/cli/announce-post.js",
    "detect-themes": "node --enable-source-maps dist/cli/detect-themes.js",
    "retry-collection": "node --enable-source-maps dist/cli/retry-collection.js",
    "events:reference": "tsx scripts/events-reference.ts",
    "research-subject": "node --enable-source-maps dist/cli/research-subject.js",
    "research-index-worker": "node --enable-source-maps dist/cli/research-index-worker.js",
    "research-reindex": "node --enable-source-maps dist/cli/research-reindex.js",
    "writer-package": "node --enable-source-maps dist/cli/writer-package.js",
    "draft-package": "node --enable-source-maps dist/cli/draft-package.js",
    "article-worker": "node --enable-source-maps dist/cli/article-worker.js",
    "captured-bridge": "node --enable-source-maps dist/cli/captured-bridge.js",
    "article-run": "node --enable-source-maps dist/cli/article-run.js",
    "install-wake-hook": "node --enable-source-maps dist/cli/install-wake-hook.js",
    "verify-package-draft": "node --enable-source-maps dist/cli/verify-package-draft.js",
    "telegram-session": "node --enable-source-maps dist/cli/telegram-session.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "@restatedev/restate-sdk": "1.18.4",
    "@restatedev/restate-sdk-clients": "1.18.4",
    "@sentry/node": "^11.16.0",
    "cloudevents": "^10.0.0",
    "html-to-text": "^10.0.1",
    "rss-parser": "^3.13.0",
    "teleproto": "^1.233.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@restatedev/restate-sdk-testcontainers": "1.18.4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "testcontainers": "12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0"
}
