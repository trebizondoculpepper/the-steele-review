{
  "name": "the-steele-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test": "vp test run test"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "cloudevents": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0"
}
