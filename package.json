{
  "name": "the-steele-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test": "vp test run test",
    "backfill": "node --enable-source-maps dist/cli/backfill.js",
    "index-worker": "node --enable-source-maps dist/cli/index-worker.js",
    "claim-timeline": "node --enable-source-maps dist/cli/claim-timeline.js",
    "replay-index": "node --enable-source-maps dist/cli/replay-index.js",
    "collect-worker": "node --enable-source-maps dist/cli/collect-worker.js",
    "provision": "node --enable-source-maps dist/cli/provision.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "cloudevents": "^6.0.3",
    "html-to-text": "^10.0.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0"
}
